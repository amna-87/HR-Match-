# Copy to .env.local and fill in. NEVER commit real values.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=Vouch
# local | staging | production. Optional: Vercel preview deployments are treated as staging automatically.
APP_ENV=local
# 32+ random chars; signs email action links (approve/decline/unsubscribe)
TOKEN_SIGNING_SECRET=
# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
# Salt used to hash IPs / user agents in consent events
CONSENT_HASH_SALT=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS: used only by trusted server code (signed URLs, auth admin, erasure).
SUPABASE_SERVICE_ROLE_KEY=
# Server-only direct Postgres connection for trusted backend code (matching engine, notifier, cron).
# On Supabase use the pooled (Supavisor, transaction mode) connection string. Local: supabase start -> DB_URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres?sslmode=disable

# --- AI ---
# Resume parsing, paste-to-structure, optional re-rank. If unset, parsing fails gracefully to manual entry.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Embeddings: "voyage" (recommended for production) or "local" (deterministic, dev/test only)
EMBEDDINGS_PROVIDER=local
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
# Optional LLM re-rank of the top 20 matches (true/false)
MATCHING_LLM_RERANK=false

# --- Email ---
# If RESEND_API_KEY is unset, emails are logged to the console and recorded as "skipped".
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Vouch <notifications@example.com>"
SUPPORT_EMAIL=support@example.com

# --- Local tests (plain Postgres + pgvector) ---
LOCAL_PG_ADMIN_URL=postgresql://postgres@localhost:54322/postgres
